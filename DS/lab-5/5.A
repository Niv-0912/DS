#include <stdio.h>
#include <string.h>

#define SIZE 100

char stack[SIZE];
int top = -1;

void push(char x)
{
    if (top == SIZE - 1)
    {
        printf("Stack Overflow\n");
    }
    else
    {
        top++;
        stack[top] = x;
    }
}

char pop()
{
    if (top == -1)
    {
        return '\0';
    }
    else
    {
        return stack[top--];
    }
}

int Matching(char op, char cl)
{
    if (op == '(' && cl == ')')
        return 1;

    if (op == '{' && cl == '}')
        return 1;

    if (op == '[' && cl == ']')
        return 1;

    return 0;
}

int Balanced(char str[])
{
    int i;
    char x;

    top = -1;

    for (i = 0; str[i] != '\0'; i++)
    {
        if (str[i] == '(' || str[i] == '{' || str[i] == '[')
        {
            push(str[i]);
        }

        else if (str[i] == ')' || str[i] == '}' || str[i] == ']')
        {
            x = pop();

            if (!isMatching(x, str[i]))
            {
                return 0;
            }
        }
    }
}

void main()
{
    int T;
    char str[SIZE];

    printf("Enter number of test cases: ");
    scanf("%d", &T);

    while (T--)
    {
        scanf("%s", str);

        printf("%d\n", isBalanced(str));
    }

    return 0;
}
